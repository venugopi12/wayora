# Dependencies
node_modules/

# Build output
dist/
build/
# Production source maps extracted from apps/web/dist (never published)
apps/web/sourcemaps/
# End-to-end failure screenshots (apps/web/e2e)
apps/web/e2e-results/
*.tsbuildinfo
coverage/

# Prisma generated client (rebuilt by `npm install` / `npm run db:generate`)
database/src/generated/

# Environment — never commit real secrets. Only *.example files are tracked.
.env
.env.*
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Vite
apps/web/.vite/
