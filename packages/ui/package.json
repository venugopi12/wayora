{
  "name": "@wayora/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Wayora design system: tokens, brand assets and accessible React components",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./motion": {
      "types": "./src/motion/index.ts",
      "default": "./src/motion/index.ts"
    },
    "./theme.css": "./src/styles/theme.css",
    "./base.css": "./src/styles/base.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@wayora/config": "0.1.0",
    "jsdom": "26.1.0",
    "motion": "12.43.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "radix-ui": "1.6.7"
  },
  "peerDependencies": {
    "motion": "^12.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  }
}
