# @wayora/web — copy to apps/web/.env (or run `npm run setup`).
#
# SECURITY: every VITE_* variable is embedded in the public JavaScript bundle.
# Only put values here that are safe for anyone on the internet to read.
# Provider/API credentials belong in apps/api/.env — never here.

# Base URL of the Wayora API (no trailing slash, no /api/v1 suffix).
# Production builds (`npm run build`) refuse to run without it and require
# https:// (plain http only for localhost). It also sets the CSP connect-src.
VITE_API_BASE_URL=http://localhost:4000

# Public origin of this site (no path, no trailing slash): used for canonical
# links, the sitemap, robots.txt, Open Graph and structured data (docs/seo.md).
# Production builds refuse to run without it and require https:// (plain http
# only for localhost). 4173 = `vite preview`.
VITE_SITE_URL=http://localhost:4173

# Build time only, NOT a VITE_ variable (never reaches the browser): the API
# origin the prerender reads published guides, collections and landing pages
# from (GET /api/v1/content/feed). Optional; without it they're client-rendered
# and left out of the sitemap.
# PRERENDER_CONTENT_URL=http://localhost:4000

# Service worker kill switch (docs/pwa.md#kill-switch): `off` builds a worker
# that removes itself and its caches from every browser. Leave unset normally.
# VITE_PWA=off
