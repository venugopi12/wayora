# @wayora/web — copy to apps/web/.env (or run `npm run setup`).
#
# SECURITY: every VITE_* variable is embedded in the public JavaScript bundle.
# Only put values here that are safe for anyone on the internet to read.
# Provider/API credentials belong in apps/api/.env — never here.

# Base URL of the Wayora API (no trailing slash, no /api/v1 suffix).
VITE_API_BASE_URL=http://localhost:4000
