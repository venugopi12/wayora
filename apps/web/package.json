    "@wayora/ui": "0.1.0",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.90.0",
    "react-router": "7.18.4",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
