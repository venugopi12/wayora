{
  "name": "@wayora/api",
  "version": "0.1.0",
  "private": true,
  "description": "Wayora REST API \u2014 modular monolith (Express, /api/v1)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "admin:role": "tsx src/scripts/admin-role.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@wayora/contracts": "0.1.0",
    "@wayora/database": "0.1.0",
    "cors": "2.8.6",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "@types/supertest": "6.0.3",
    "@wayora/config": "0.1.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
