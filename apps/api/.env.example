# @wayora/api — copy to apps/api/.env (or run `npm run setup` from the repo root).
# Local development values only. Never commit a real .env.
#
# Production (NODE_ENV=production) is stricter and refuses to start when:
#   - DATABASE_URL or REDIS_URL contains the local development password below,
#   - CORS_ORIGIN, WEB_ORIGIN or API_BASE_URL isn't https://,
#   - REDIS_URL is missing (search sessions must be shared: required there).
# Demo inventory and demo payments are OFF in production unless enabled
# explicitly. The full production checklist: docs/deployment.md.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Logging: LOG_LEVEL = fatal|error|warn|info|debug|trace ; LOG_FORMAT = json|pretty
LOG_LEVEL=info
LOG_FORMAT=pretty

# Essential — the API reports "unready" (HTTP 503) without it.
DATABASE_URL="postgresql://wayora:wayora_local_dev_only@localhost:5432/wayora?schema=public"

# Search sessions + shared rate limits + worker queue. Optional in development
# (leave empty to disable); REQUIRED in production. When set but unreachable the
# API stays up and reports "degraded"; rate limits then fall back to per-process.
REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed to call the API. "*" is rejected.
# 5173 = `npm run dev:web`, 4173 = `vite preview` of a production build.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Canonical public URL of the web app (future: email links, OAuth redirects).
WEB_ORIGIN=http://localhost:5173
# Public base URL of this API (future: provider/PSP webhook callback URLs).
API_BASE_URL=http://localhost:4000

# Set to the number of proxy hops (e.g. 1) when running behind a load balancer or
# reverse proxy; otherwise every client shares the proxy's IP for rate limits.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

HEALTH_CHECK_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=10000

# Accounts and sessions (Phase 8, docs/auth.md). Sessions are random tokens
# stored hashed in PostgreSQL, so no session secret is needed.
# Sign out after this many hours without activity, and after this many at most.
SESSION_IDLE_TIMEOUT_HOURS=168
SESSION_ABSOLUTE_TIMEOUT_HOURS=720
# Sign-in + registration attempts per IP, and failed sign-ins per email, per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
LOGIN_FAILURES_PER_EMAIL_MAX=10

# Travel search (Phase 9, docs/search.md).
# Demo providers serve labelled sample fixtures. Unset: on in development and
# test, OFF in production. Set to true or false to override.
SEARCH_DEMO_PROVIDERS=
# Comma-separated provider ids to switch off, e.g. demo-cabs.
SEARCH_DISABLED_PROVIDERS=
# Searches per client IP per minute.
SEARCH_RATE_LIMIT_MAX=30
# Demo booking creations and cancellations per signed-in user per minute.
BOOKING_RATE_LIMIT_MAX=10

# Payments (Phase 13, docs/payments.md#configuration-appsapienv). There are no
# payment credentials: the only provider is the demo simulator (no money moves).
# Unset = demo in development/test, none (payments off) in production.
PAYMENT_PROVIDER=
# Let requests choose a demo outcome (decline, pending…). Unset = on outside production.
PAYMENT_DEMO_SCENARIOS=
PAYMENT_WINDOW_MINUTES=30
PAYMENT_DEMO_PENDING_SECONDS=8
# Payment starts and cancellations per signed-in user per minute.
PAYMENT_RATE_LIMIT_MAX=10
# Notification writes (mark read, read all, preferences) per signed-in user per minute.
NOTIFICATION_RATE_LIMIT_MAX=60
# Trip-planner writes (trips, activities, reorders) per signed-in user per minute (docs/planner.md).
PLANNER_RATE_LIMIT_MAX=120

# Trip tracking (Phase 17, docs/trips.md#configuration).
# Travel-status provider: demo (SIMULATED status and disruptions, labelled as
# such) or none. No live provider exists yet. Unset: demo here, none in production.
TRAVEL_STATUS_PROVIDER=
# A status observed within this many seconds counts as current; older is stale.
TRAVEL_STATUS_FRESH_SECONDS=300
# A booking's provider is asked at most once per this many seconds.
TRAVEL_STATUS_MIN_REFRESH_SECONDS=60
TRAVEL_STATUS_TIMEOUT_MS=5000
# "Check now" requests per signed-in user per minute.
TRAVEL_STATUS_REFRESH_RATE_LIMIT_MAX=10
# Background checks of trips travelling around today; 0 turns them off.
TRAVEL_STATUS_SWEEP_SECONDS=300

# Search sessions (Phase 11, docs/search.md#search-sessions).
# Where they live: redis (shared by every API instance, kept across restarts) or
# memory (one process, local development only). Unset: redis when REDIS_URL is
# set, else memory. Production refuses anything but redis.
SEARCH_SESSION_STORE=
# Session lifetime in seconds (60-1800): reused for paging, sorting and filtering,
# read by offer pages. Offers are valid only within it. (Old name:
# SEARCH_CACHE_TTL_SECONDS, still accepted.)
SEARCH_SESSION_TTL_SECONDS=600

# Provider calls (docs/search.md#timeouts-retries-and-circuit-breakers).
# Time budget per search or offer check, retries included (500-14000 ms; the web
# client gives up after 15 s).
SEARCH_DEADLINE_MS=8000
# Attempts per provider call (1-4). Only transient failures of read-only calls retry.
SEARCH_PROVIDER_MAX_ATTEMPTS=2
# Exponential backoff base with full jitter (0-2000 ms; the cap is 8x the base).
SEARCH_PROVIDER_RETRY_BASE_MS=200
# Consecutive failed calls that open a provider's circuit breaker (1-100), and
# how long it stays open before one trial call (1-600 s).
SEARCH_BREAKER_FAILURE_THRESHOLD=5
SEARCH_BREAKER_COOLDOWN_SECONDS=30
