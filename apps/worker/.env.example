# @wayora/worker — copy to apps/worker/.env (or run `npm run setup`).
# Local development values only.
#
# Production (NODE_ENV=production) refuses to start without DATABASE_URL, with
# the local development password below, or with a non-https WEB_ORIGIN.
# See docs/deployment.md.

NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=pretty

# Essential for the worker: it cannot run without Redis.
REDIS_URL=redis://localhost:6379

WORKER_CONCURRENCY=5
SHUTDOWN_TIMEOUT_MS=15000

# Notification delivery (Phase 14, docs/notifications.md#worker): the email
# outbox lives in PostgreSQL. Without DATABASE_URL that job is off (development
# only; required in production). No email
# provider is configured, so deliveries are recorded as NOT_CONFIGURED.
DATABASE_URL="postgresql://wayora:wayora_local_dev_only@localhost:5432/wayora?schema=public"
# Public web origin for links in emails.
WEB_ORIGIN=http://localhost:5173
NOTIFICATION_DISPATCH_INTERVAL_MS=15000

# Browser push notifications (Phase 30, docs/pwa.md#push). Set all three, or
# none (push off: deliveries recorded as NOT_CONFIGURED, nothing sent).
# Generate a pair once with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is a SECRET: keep it in the secret store, never in the web app.
# The API's VAPID_PUBLIC_KEY must be the same public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
