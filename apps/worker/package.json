{
  "name": "@wayora/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Wayora background worker (BullMQ)",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "job:example": "tsx src/scripts/enqueue-example.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wayora/contracts": "0.1.0",
    "@wayora/database": "0.1.0",
    "bullmq": "5.81.5",
    "pino": "9.14.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/web-push": "3.6.4",
    "@wayora/config": "0.1.0",
    "http_ece": "1.2.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
