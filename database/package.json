{
  "name": "@wayora/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and client for Wayora (PostgreSQL)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:check": "prisma migrate diff --from-config-datasource --to-schema schema.prisma --exit-code",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@wayora/config": "0.1.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
