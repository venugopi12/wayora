// Wayora — Phase 1 foundational schema.
//
// Conventions (see docs/architecture.md#database):
// - Primary keys are UUIDv7 (time-ordered, index-friendly), stored as native `uuid`.
// - All timestamps are `timestamptz(3)` and written in UTC.
// - Money is stored as BIGINT minor units (`*AmountMinor`) + ISO 4217 `currency`.
//   Never use Float/Decimal-with-float-math for money.
// - Table/column names are snake_case via @@map/@map; Prisma models are PascalCase.
// - CHECK constraints that Prisma cannot express live in the migration SQL.
// - No raw card data is ever stored. Payment references come from the PSP.

// Prisma 7 TypeScript client (no native query engine). Generated into
// src/generated/prisma (git-ignored) and re-exported by src/index.ts.
generator client {
  provider            = "prisma-client"
  output              = "./src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Connection URL is configured in prisma.config.ts (CLI) and passed to the
// pg driver adapter at runtime (src/index.ts).
datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

/// Staff roles (Phase 15, docs/admin.md#roles). Everyone else is USER.
enum UserRole {
  USER
  /// Read-only operations access (no audit logs).
  SUPPORT
  /// Full admin dashboard access.
  ADMIN

  @@map("user_role")
}

/// Outcome of one search request (Phase 15 search analytics).
enum SearchOutcome {
  /// Every provider answered; at least one result.
  SUCCESS
  /// Results, but some providers failed or timed out.
  PARTIAL
  /// Providers answered; nothing matched.
  EMPTY
  /// The request failed (no results returned to the visitor).
  FAILED

  @@map("search_outcome")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

/// Mirrors `travelCategorySlugSchema` in @wayora/contracts.
enum TravelCategory {
  FLIGHT
  HOTEL
  TRAIN
  BUS
  METRO
  CAB
  HOLIDAY_PACKAGE

  @@map("travel_category")
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
  FAILED

  @@map("order_status")
}

enum BookingStatus {
  PENDING
  HELD
  CONFIRMED
  CANCELLED
  FAILED
  /// Not paid within the payment window (Phase 13).
  EXPIRED

  @@map("booking_status")
}

/// How a booking is paid (Phase 13, docs/payments.md#booking-payment-mode).
enum BookingPaymentMode {
  /// Nothing is paid on Wayora (Phase 12 bookings, payments off, estimate prices).
  NONE
  /// A simulated payment is required before the demo confirmation.
  DEMO

  @@map("booking_payment_mode")
}

/// Payment attempt lifecycle (docs/payments.md#states).
enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

/// Notification events (Phase 14, docs/notifications.md#events).
enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  /// A supplier reservation failed (Phase 23; never for demo bookings).
  BOOKING_FAILED
  PAYMENT_PENDING
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  TRAVEL_REMINDER
  /// A travel disruption reported, changed or resolved (Phase 17, docs/trips.md).
  TRIP_DISRUPTION
  /// Trip planner collaboration (Phase 19, docs/planner.md#notifications).
  PLAN_INVITATION
  PLAN_INVITATION_ACCEPTED
  PLAN_INVITATION_DECLINED
  PLAN_MEMBER_CHANGED
  PLAN_UPDATED
  /// Loyalty points and travel credits (Phase 25, docs/rewards.md#notifications). In-app only.
  REWARDS

  @@map("notification_type")
}

/// Trip timeline entries (Phase 17, docs/trips.md#timeline).
enum TripEventType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  BOOKING_FAILED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REFUND_PENDING
  PAYMENT_REFUNDED
  TRAVEL_REMINDER
  CHECK_OUT_REMINDER
  STATUS_CHANGED
  DISRUPTION_REPORTED
  DISRUPTION_UPDATED
  DISRUPTION_RESOLVED

  @@map("trip_event_type")
}

/// Where a timeline entry, status or disruption came from.
enum TripEventSource {
  /// Wayora's own records (bookings, payments, reminders).
  WAYORA
  /// The simulated travel-status provider: never verified travel information.
  DEMO_PROVIDER
  /// A configured, real travel-status provider.
  LIVE_PROVIDER

  @@map("trip_event_source")
}

enum DisruptionType {
  DEPARTURE_DELAY
  ARRIVAL_DELAY
  CANCELLATION
  SCHEDULE_CHANGE
  SERVICE_DISRUPTION
  BOOKING_CHANGE

  @@map("disruption_type")
}

enum DisruptionSeverity {
  INFO
  MINOR
  MAJOR
  SEVERE

  @@map("disruption_severity")
}

enum DisruptionState {
  ACTIVE
  RESOLVED

  @@map("disruption_state")
}

enum NotificationChannel {
  EMAIL

  @@map("notification_channel")
}

/// Outbox states of one delivery (docs/notifications.md#delivery).
enum NotificationDeliveryStatus {
  /// Waiting for (or between) delivery attempts.
  PENDING
  /// The provider accepted it.
  SENT
  /// Gave up: permanent error, or retries exhausted.
  FAILED
  /// No email provider is configured: nothing was sent.
  NOT_CONFIGURED

  @@map("notification_delivery_status")
}

/// DEMO: simulated, no money moves. LIVE: reserved for a real gateway.
enum PaymentMode {
  DEMO
  LIVE

  @@map("payment_mode")
}

/// Passenger types where a fare distinguishes them (flights).
enum PassengerType {
  ADULT
  CHILD
  INFANT

  @@map("passenger_type")
}

enum BookingItemStatus {
  ACTIVE
  CANCELLED

  @@map("booking_item_status")
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("idempotency_key_status")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED

  @@map("webhook_event_status")
}

enum AuditActorType {
  USER
  SYSTEM
  ADMIN
  PROVIDER

  @@map("audit_actor_type")
}

// ─── Identity ─────────────────────────────────────────────────────────────

/// An account holder. Signs in with email + password (Phase 8).
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Normalized (trimmed, lower-cased) by the application and enforced by a
  /// CHECK constraint, so the unique index is effectively case-insensitive.
  email           String     @unique @db.VarChar(320)
  /// Set only by a real verification flow (not implemented yet).
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// The person's name, as shown in the app ("name" in the API).
  displayName     String?    @map("display_name") @db.VarChar(120)
  /// Argon2id PHC string. Null for accounts without a password (e.g. seed data),
  /// which therefore cannot sign in. Never returned by the API.
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  /// E.164 format, e.g. +919876543210.
  phoneE164       String?    @map("phone_e164") @db.VarChar(16)
  status          UserStatus @default(ACTIVE)
  /// Staff role; never changed through customer APIs (docs/admin.md#provisioning).
  role            UserRole   @default(USER)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  travellers Traveller[]
  orders     Order[]
  sessions   Session[]
  bookings   Booking[]
  payments   Payment[]

  notifications           Notification[]
  notificationPreferences NotificationPreference?

  plannedTrips PlannedTrip[]

  tripMemberships       TripMember[]       @relation("TripMemberUser")
  tripMembersInvited    TripMember[]       @relation("TripMemberInvitedBy")
  tripInvitations       TripInvitation[]   @relation("TripInvitationInvitee")
  tripInvitationsSent   TripInvitation[]   @relation("TripInvitationInvitedBy")
  plannerActivities     PlannerActivity[]
  itineraryItemsCreated ItineraryItem[]

  planExpensesCreated  PlanExpense[]
  planExpenseParts     PlanExpensePart[]
  settlementsSent      PlanSettlement[] @relation("SettlementFrom")
  settlementsReceived  PlanSettlement[] @relation("SettlementTo")
  settlementsRecorded  PlanSettlement[] @relation("SettlementRecordedBy")

  assistantConversations AssistantConversation[]
  assistantRequests      AssistantRequest[]
  /// Refunds of this user's payments (Phase 23).
  refunds                Refund[]
  assistantActions       AssistantAction[]

  /// Loyalty (Phase 25, docs/rewards.md).
  loyaltyAccounts    LoyaltyAccount[]
  rewardTransactions RewardTransaction[]
  travelCredits      TravelCredit[]
  rewardRedemptions  RewardRedemption[]

  /// Promotions (Phase 26, docs/promotions.md): personal offers, and uses.
  personalPromotions   Promotion[]           @relation("PromotionForUser")
  promotionRedemptions PromotionRedemption[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// A signed-in browser session. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a database leak does not expose usable sessions.
/// A session authenticates only while revokedAt is null, expiresAt is in the
/// future and the user is ACTIVE (docs/auth.md#session-lifecycle).
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Hex SHA-256 of the cookie token.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Refreshed at most every few minutes while the session is used.
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// min(createdAt + absolute lifetime, lastActivityAt + idle timeout).
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A person who travels on a booking (may differ from the account holder).
/// Identity documents (passport etc.) are deliberately NOT modelled yet; they
/// require field-level encryption and a retention policy first.
model Traveller {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  firstName   String    @map("first_name") @db.VarChar(100)
  lastName    String    @map("last_name") @db.VarChar(100)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  /// ISO 3166-1 alpha-2.
  nationality String?   @db.Char(2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([userId])
  @@map("travellers")
}

// ─── Commerce ─────────────────────────────────────────────────────────────

/// The customer-facing purchase. One order can contain bookings across
/// categories (e.g. a flight + a hotel) and is the unit of payment.
model Order {
  id               String      @id @default(uuid(7)) @db.Uuid
  /// Human-friendly, customer-visible reference, e.g. WY-7KQ2-M9XD.
  reference        String      @unique @db.VarChar(32)
  userId           String      @map("user_id") @db.Uuid
  status           OrderStatus @default(DRAFT)
  currency         String      @db.Char(3)
  totalAmountMinor BigInt      @default(0) @map("total_amount_minor")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

/// A reservation of one offer (Phase 12: demo bookings; docs/bookings.md).
///
/// Demo bookings (`isDemo`) are created and confirmed by Wayora alone: no
/// supplier reservation, ticket or payment exists, so `providerReference` stays
/// null. The offer is kept as an immutable snapshot; a trigger rejects changes
/// to it and to the other booked facts. Payments later attach bookings to an
/// `Order` (the unit of payment), hence the optional `orderId`.
model Booking {
  id                String             @id @default(uuid(7)) @db.Uuid
  /// Customer-visible reference, e.g. WYD-7KQ2-M9XD ("WYD": Wayora demo booking).
  reference         String             @unique @db.VarChar(32)
  userId            String             @map("user_id") @db.Uuid
  orderId           String?            @map("order_id") @db.Uuid
  category          TravelCategory
  status            BookingStatus      @default(PENDING)
  /// Simulated booking: no supplier reservation, ticket or payment.
  isDemo            Boolean            @map("is_demo")
  /// Provider identifier, e.g. "demo-flights".
  provider          String?            @db.VarChar(64)
  /// Provider-side reference (PNR, confirmation number). Never set for demo bookings.
  providerReference String?            @map("provider_reference") @db.VarChar(128)
  /// The search session the offer came from (sessions expire; kept for support).
  searchId          String?            @map("search_id") @db.Uuid
  /// The offer as booked: validated contract JSON (see docs/bookings.md#snapshot).
  offerSnapshot     Json               @map("offer_snapshot")
  /// People the booked price covers.
  partySize         Int                @map("party_size")
  /// Local travel dates from the offer; null where it has none (metro).
  startsOn          DateTime?          @map("starts_on") @db.Date
  endsOn            DateTime?          @map("ends_on") @db.Date
  /// E.164 mobile number, only for categories that need one (cabs).
  contactPhone      String?            @map("contact_phone") @db.VarChar(16)
  currency          String             @db.Char(3)
  /// The booked total. Null when the offer's price is an estimate range (cabs);
  /// the range is in the snapshot.
  totalAmountMinor  BigInt?            @map("total_amount_minor")
  /// How it is paid; fixed when booked (Phase 13).
  paymentMode       BookingPaymentMode @map("payment_mode")
  /// Pay before this or the booking expires (payment mode DEMO only).
  paymentDueAt      DateTime?          @map("payment_due_at") @db.Timestamptz(3)
  confirmedAt       DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  order         Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items         BookingItem[]
  travellers    BookingTraveller[]
  events        BookingStatusEvent[]
  payments      Payment[]
  notifications Notification[]
  tripEvents    TripEvent[]
  /// Planned trips the owner chose to link to this booking (Phase 18).
  plannedTrips  PlannedTrip[]
  /// Plan expenses imported from this booking (Phase 20).
  planExpenses  PlanExpense[]
  tripStatus    TripStatus?
  disruptions   TripDisruption[]
  /// The supplier reservation of a non-demo booking (Phase 23).
  reservation   SupplierReservation?
  documents     TravelDocument[]
  refunds       Refund[]
  /// Loyalty (Phase 25): rewards earned on it, credits linked to it, rewards spent on it.
  rewardTransactions RewardTransaction[]
  travelCredits      TravelCredit[]
  rewardRedemptions  RewardRedemption[]
  /// Promotions applied to it (Phase 26).
  promotionRedemptions PromotionRedemption[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([category, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, startsOn])
  @@index([status, paymentDueAt])
  @@index([createdAt(sort: Desc)])
  @@index([searchId])
  @@map("bookings")
}

/// A named person on a booking, copied from the booking form (immutable).
/// Not linked to saved travellers: editing a saved traveller never changes a booking.
model BookingTraveller {
  id        String         @id @default(uuid(7)) @db.Uuid
  bookingId String         @map("booking_id") @db.Uuid
  /// Order on the booking (0-based), as the form listed them.
  position  Int            @db.SmallInt
  /// Only for fares that distinguish passenger types (flights).
  type      PassengerType?
  firstName String         @map("first_name") @db.VarChar(100)
  lastName  String         @map("last_name") @db.VarChar(100)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
  @@map("booking_travellers")
}

/// Append-only status history of a booking (a trigger blocks UPDATE and DELETE).
model BookingStatusEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  /// Null for the event that created the booking.
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorType  AuditActorType @map("actor_type")
  /// Plain-words explanation, e.g. that a demo confirmation contacted no supplier.
  note       String?        @db.VarChar(255)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_events")
}

/// A priced line within a booking (a seat, a room-night, a fare component).
// ─── Payments (Phase 13) ──────────────────────────────────────────────────

/// One attempt to pay for one booking (docs/payments.md). Separate from the
/// booking's lifecycle: a succeeded payment never means a supplier reserved
/// anything. Rows are kept for audit; card or bank details are never stored
/// (the demo provider takes none; a real gateway keeps them on its side).
model Payment {
  id                 String        @id @default(uuid(7)) @db.Uuid
  bookingId          String        @map("booking_id") @db.Uuid
  /// The owner (the booking's user), kept for direct ownership checks.
  userId             String        @map("user_id") @db.Uuid
  /// 1, 2, … per booking.
  attempt            Int           @db.SmallInt
  mode               PaymentMode
  /// Provider id, e.g. "demo".
  provider           String        @db.VarChar(64)
  /// The provider's id for this attempt (never a secret). Set once.
  providerReference  String?       @map("provider_reference") @db.VarChar(128)
  status             PaymentStatus @default(CREATED)
  currency           String        @db.Char(3)
  /// From the booking's record, never from the client.
  amountMinor        BigInt        @map("amount_minor")
  /// The simulated outcome asked for (DEMO mode only).
  demoScenario       String?       @map("demo_scenario") @db.VarChar(32)
  /// SHA-256 of the client's Idempotency-Key (the key itself isn't kept here).
  idempotencyKeyHash String?       @map("idempotency_key_hash") @db.Char(64)
  /// Safe, user-facing failure reason.
  failureCode        String?       @map("failure_code") @db.VarChar(64)
  failureMessage     String?       @map("failure_message") @db.VarChar(255)
  /// Succeeded after its booking was cancelled or expired: money would be owed back.
  refundRequired     Boolean       @default(false) @map("refund_required")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When it first reached succeeded, failed or cancelled.
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(3)

  booking       Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  events        PaymentStatusEvent[]
  notifications Notification[]
  refunds       Refund[]

  @@unique([bookingId, attempt])
  @@unique([provider, providerReference])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

/// Append-only history of a payment's status (a trigger forbids changes).
model PaymentStatusEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  paymentId       String         @map("payment_id") @db.Uuid
  /// Null for the event that created the payment.
  fromStatus      PaymentStatus? @map("from_status")
  toStatus        PaymentStatus  @map("to_status")
  actorType       AuditActorType @map("actor_type")
  /// The provider event that caused it (see webhook_events), if any.
  providerEventId String?        @map("provider_event_id") @db.VarChar(255)
  note            String?        @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@map("payment_status_events")
}

// ─── Notifications (Phase 14) ─────────────────────────────────────────────

/// One in-app notification for one user, created in the same transaction as
/// the state change it reports (docs/notifications.md).
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  /// Plain text, written by Wayora (never provider text). No traveller names.
  title     String           @db.VarChar(120)
  message   String           @db.VarChar(500)
  /// The event concerns a demo booking or demo payment.
  isDemo    Boolean          @map("is_demo")
  bookingId String?          @map("booking_id") @db.Uuid
  paymentId String?          @map("payment_id") @db.Uuid
  /// Planner notifications (Phase 19): the plan, or the invitation, it is about.
  plannedTripId    String?   @map("planned_trip_id") @db.Uuid
  tripInvitationId String?   @map("trip_invitation_id") @db.Uuid
  /// One notification per event: e.g. "payment:<id>:SUCCEEDED".
  dedupeKey String           @unique @map("dedupe_key") @db.VarChar(200)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking    Booking?               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment    Payment?               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  plannedTrip    PlannedTrip?    @relation(fields: [plannedTripId], references: [id], onDelete: SetNull)
  tripInvitation TripInvitation? @relation(fields: [tripInvitationId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([plannedTripId])
  @@index([tripInvitationId])
  @@map("notifications")
}

/// Outbox: one optional channel delivery of a notification, written with it
/// and processed by the worker (docs/notifications.md#delivery).
model NotificationDelivery {
  id                String                     @id @default(uuid(7)) @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// A worker's lease while it works on this row.
  lockedUntil       DateTime?                  @map("locked_until") @db.Timestamptz(3)
  /// Safe, short error class/code (never provider bodies or addresses).
  lastError         String?                    @map("last_error") @db.VarChar(255)
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(255)
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// Optional-channel preferences. No row means the defaults (all on).
/// In-app notifications are always kept, whatever these say.
model NotificationPreference {
  userId         String   @id @map("user_id") @db.Uuid
  emailBookings  Boolean  @default(true) @map("email_bookings")
  emailPayments  Boolean  @default(true) @map("email_payments")
  emailReminders Boolean  @default(true) @map("email_reminders")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Search analytics (Phase 15) ──────────────────────────────────────────

/// One search request, for operational analytics (docs/admin.md#search).
/// Holds no request details (places, dates, travellers) and no user id:
/// only the category, outcome, counts and provider timings.
model SearchEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  category    TravelCategory
  outcome     SearchOutcome
  /// The search session id (links to bookings.search_id); null when it failed.
  searchId    String?        @map("search_id") @db.Uuid
  resultCount Int            @map("result_count")
  durationMs  Int            @map("duration_ms")
  /// Safe error code when it failed, e.g. PROVIDER_TIMEOUT.
  errorCode   String?        @map("error_code") @db.VarChar(64)
  /// [{ id, status, durationMs }] per provider (no supplier payloads).
  providers   Json
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([searchId])
  @@map("search_events")
}

model BookingItem {
  id               String            @id @default(uuid(7)) @db.Uuid
  bookingId        String            @map("booking_id") @db.Uuid
  travellerId      String?           @map("traveller_id") @db.Uuid
  status           BookingItemStatus @default(ACTIVE)
  description      String            @db.VarChar(255)
  quantity         Int               @default(1)
  currency         String            @db.Char(3)
  unitAmountMinor  BigInt            @map("unit_amount_minor")
  totalAmountMinor BigInt            @map("total_amount_minor")
  /// Category-specific, non-sensitive attributes (e.g. cabin class, room type).
  attributes       Json?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  traveller Traveller? @relation(fields: [travellerId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([travellerId])
  @@map("booking_items")
}

// ─── Reliability & compliance ─────────────────────────────────────────────

/// Stores the outcome of mutating requests so client retries are safe.
/// Rows are short-lived; a scheduled worker job purges expired keys.
model IdempotencyKey {
  id             String               @id @default(uuid(7)) @db.Uuid
  /// Client-supplied `Idempotency-Key` header value.
  key            String               @db.VarChar(255)
  /// Operation the key applies to, e.g. "POST /api/v1/orders".
  scope          String               @db.VarChar(128)
  /// Owner of the key; keys are never shared across users.
  userId         String?              @map("user_id") @db.Uuid
  /// SHA-256 of the canonical request body; mismatches are rejected.
  requestHash    String               @map("request_hash") @db.Char(64)
  status         IdempotencyKeyStatus @default(IN_PROGRESS)
  responseStatus Int?                 @map("response_status") @db.SmallInt
  responseBody   Json?                @map("response_body")
  lockedUntil    DateTime?            @map("locked_until") @db.Timestamptz(3)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Inbound provider/PSP webhooks, recorded before processing so delivery is
/// at-least-once and processing is idempotent (unique provider + external id).
model WebhookEvent {
  id                String             @id @default(uuid(7)) @db.Uuid
  provider          String             @db.VarChar(64)
  /// The provider's event ID — used for de-duplication.
  externalId        String             @map("external_id") @db.VarChar(255)
  eventType         String             @map("event_type") @db.VarChar(128)
  /// Verified payload. Must never contain raw card data (PSPs do not send it).
  payload           Json
  signatureVerified Boolean            @default(false) @map("signature_verified")
  status            WebhookEventStatus @default(RECEIVED)
  attempts          Int                @default(0)
  lastError         String?            @map("last_error")
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

/// Append-only record of security- and money-relevant actions.
model AuditLog {
  id         String         @id @default(uuid(7)) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.VarChar(64)
  /// Dot-namespaced verb, e.g. "order.status_changed".
  action     String         @db.VarChar(128)
  entityType String         @map("entity_type") @db.VarChar(64)
  entityId   String         @map("entity_id") @db.VarChar(64)
  requestId  String?        @map("request_id") @db.VarChar(128)
  /// Non-sensitive context (before/after status, reason codes). No secrets/PII.
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// The trip timeline (Phase 17, docs/trips.md#timeline). Append-only (a
/// trigger blocks UPDATE and DELETE); corrections are new entries. Booking and
/// payment status changes are copied in by database triggers from their
/// history tables; reminders, travel status and disruptions are written by
/// the API. `dedupe_key` makes every write idempotent.
model TripEvent {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Insertion order, for tie-breaking and realtime event ids.
  seq        BigInt          @unique @default(autoincrement())
  bookingId  String          @map("booking_id") @db.Uuid
  type       TripEventType
  source     TripEventSource
  dedupeKey  String          @unique @map("dedupe_key") @db.VarChar(200)
  /// When it happened (for provider data: when the provider says it changed).
  occurredAt DateTime        @map("occurred_at") @db.Timestamptz(3)
  /// When the provider observed it; null for Wayora's own events.
  observedAt DateTime?       @map("observed_at") @db.Timestamptz(3)
  /// Safe display data only (statuses, times, amounts); no names or contact details.
  data       Json
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, occurredAt, seq])
  @@map("trip_events")
}

/// The latest travel-status observation for a booking (one row per booking).
/// Only a newer observation replaces it (docs/trips.md#freshness).
model TripStatus {
  bookingId     String          @id @map("booking_id") @db.Uuid
  providerId    String          @map("provider_id") @db.VarChar(64)
  source        TripEventSource
  /// Normalized legs: state, scheduled and estimated times, delay.
  legs          Json
  /// When the provider observed this status.
  observedAt    DateTime?       @map("observed_at") @db.Timestamptz(3)
  /// When Wayora last asked (successfully or not).
  checkedAt     DateTime        @map("checked_at") @db.Timestamptz(3)
  /// Normalized code of the last failed check (never provider text); null after a success.
  lastErrorCode String?         @map("last_error_code") @db.VarChar(32)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([checkedAt])
  @@map("trip_statuses")
}

/// A travel disruption affecting a booking, from a provider (docs/trips.md#disruptions).
/// One row per provider disruption; its changes are timeline entries.
model TripDisruption {
  id              String             @id @default(uuid(7)) @db.Uuid
  bookingId       String             @map("booking_id") @db.Uuid
  providerId      String             @map("provider_id") @db.VarChar(64)
  source          TripEventSource
  /// The provider's identifier for this disruption (stable across polls).
  externalKey     String             @map("external_key") @db.VarChar(128)
  type            DisruptionType
  severity        DisruptionSeverity
  state           DisruptionState
  /// Leg it affects (index into the booking's legs), if one.
  legIndex        Int?               @map("leg_index") @db.SmallInt
  /// What changed, normalized (times, delay minutes); no provider text.
  details         Json
  firstDetectedAt DateTime           @map("first_detected_at") @db.Timestamptz(3)
  /// Provider observation time of the latest information.
  lastObservedAt  DateTime           @map("last_observed_at") @db.Timestamptz(3)
  resolvedAt      DateTime?          @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, providerId, externalKey])
  @@index([bookingId, state])
  @@map("trip_disruptions")
}

// ─── Trip planner (Phase 18) ──────────────────────────────────────────────

/// Kind of planned activity. Mirrors `activityCategorySchema` in @wayora/contracts.
enum ActivityCategory {
  SIGHTSEEING
  CULTURE
  FOOD
  NATURE
  BEACH
  ADVENTURE
  SHOPPING
  NIGHTLIFE
  WELLNESS
  TRANSPORT
  OTHER

  @@map("activity_category")
}

enum PlanningPace {
  RELAXED
  BALANCED
  PACKED

  @@map("planning_pace")
}

enum PlanningBudget {
  SHOESTRING
  MODERATE
  PREMIUM

  @@map("planning_budget")
}

enum PlanningGroup {
  SOLO
  COUPLE
  FAMILY
  FRIENDS

  @@map("planning_group")
}

/// A user's own trip plan (docs/planner.md#data-model). A plan, never a
/// booking: it reserves nothing. Its days are the dates from start to end
/// (destination-local calendar dates, no time zone).
model PlannedTrip {
  id              String             @id @default(uuid(7)) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  title           String             @db.VarChar(120)
  /// Curated sample destination id (e.g. "goa"); null for a free-text destination.
  destinationId   String?            @map("destination_id") @db.VarChar(40)
  destinationName String             @map("destination_name") @db.VarChar(120)
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  notes           String?            @db.VarChar(2000)
  /// Optional planning preferences (all nullable / empty = no preference).
  pace            PlanningPace?
  budget          PlanningBudget?
  groupType       PlanningGroup?     @map("group_type")
  interests       ActivityCategory[] @default([])
  /// A confirmed booking of the same user, linked only by explicit choice.
  bookingId       String?            @map("booking_id") @db.Uuid
  /// Bumped on every trip-detail change; edits based on an older one are refused.
  version         Int                @default(1)
  /// Bumped on every change to the plan, its itinerary or its members (Phase 19);
  /// each bump has one planner_activities row.
  revision        Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  items   ItineraryItem[]

  members       TripMember[]
  invitations   TripInvitation[]
  activities    PlannerActivity[]
  notifications Notification[]

  /// The plan's money budget (Phase 20); `budget` above is the planning preference.
  moneyBudget PlanBudget?
  expenses    PlanExpense[]
  settlements PlanSettlement[]

  assistantConversations AssistantConversation[]
  assistantActions       AssistantAction[]

  @@index([userId, startDate, id])
  @@index([bookingId])
  @@map("planned_trips")
}

/// One planned activity on one day of a planned trip. (trip_id, day, position)
/// is unique (deferrable, so a reorder can swap positions in one statement);
/// that constraint also serves the itinerary read. Hand-written in the migration.
model ItineraryItem {
  id              String           @id @default(uuid(7)) @db.Uuid
  tripId          String           @map("trip_id") @db.Uuid
  /// Destination-local calendar date.
  day             DateTime         @db.Date
  /// 0-based order within the day, gap-free.
  position        Int
  title           String           @db.VarChar(120)
  category        ActivityCategory
  /// Wall-clock start at the destination, minutes after midnight (0–1439).
  startMinute     Int?             @map("start_minute") @db.SmallInt
  durationMinutes Int?             @map("duration_minutes") @db.SmallInt
  location        String?          @db.VarChar(160)
  notes           String?          @db.VarChar(1000)
  /// Curated sample suggestion it came from; at most once per trip.
  suggestionId    String?          @map("suggestion_id") @db.VarChar(102)
  /// Bumped on every edit; an edit based on an older version is refused (Phase 19).
  version         Int              @default(1)
  /// Who added it (null for older activities, or a deleted account).
  createdById     String?          @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      PlannedTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("itinerary_items")
}

// ─── Plan collaboration (Phase 19) ────────────────────────────────────────

/// A member's role. The owner is planned_trips.user_id, never a member row.
enum TripMemberRole {
  EDITOR
  VIEWER

  @@map("trip_member_role")
}

enum TripInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED

  @@map("trip_invitation_status")
}

/// Mirrors `plannerActivityTypeSchema` in @wayora/contracts.
enum PlannerActivityType {
  TRIP_UPDATED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_MOVED
  ITEM_DELETED
  ITEM_DUPLICATED
  DAY_REORDERED
  MEMBER_INVITED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_REVOKED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  MEMBER_LEFT
  /// Budget and expenses (Phase 20).
  BUDGET_UPDATED
  BUDGET_REMOVED
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_RECORDED
  SETTLEMENT_DELETED

  @@map("planner_activity_type")
}

/// Someone other than the owner who can see (VIEWER) or also edit (EDITOR) a
/// plan (docs/planner.md#collaboration). A trigger keeps the owner out.
model TripMember {
  id          String         @id @default(uuid(7)) @db.Uuid
  tripId      String         @map("trip_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        TripMemberRole
  invitedById String?        @map("invited_by_id") @db.Uuid
  joinedAt    DateTime       @map("joined_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      PlannedTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User        @relation("TripMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?       @relation("TripMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

/// An invitation to one existing account. Accepted only by that account,
/// signed in; at most one PENDING per person and trip (partial unique index).
model TripInvitation {
  id          String               @id @default(uuid(7)) @db.Uuid
  tripId      String               @map("trip_id") @db.Uuid
  inviteeId   String               @map("invitee_id") @db.Uuid
  invitedById String?              @map("invited_by_id") @db.Uuid
  role        TripMemberRole
  status      TripInvitationStatus @default(PENDING)
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz(3)
  respondedAt DateTime?            @map("responded_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip          PlannedTrip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitee       User           @relation("TripInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  invitedBy     User?          @relation("TripInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([inviteeId, status])
  @@index([tripId, status])
  @@map("trip_invitations")
}

/// One change to a plan (append-only; docs/planner.md#activity-history).
/// `revision` is the plan's revision after the change: unique per plan, so a
/// change is recorded exactly once.
model PlannerActivity {
  id        String              @id @default(uuid(7)) @db.Uuid
  tripId    String              @map("trip_id") @db.Uuid
  revision  Int
  actorId   String?             @map("actor_id") @db.Uuid
  type      PlannerActivityType
  /// Safe details: ids, roles, field names, activity titles and days. No emails.
  data      Json
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  trip  PlannedTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([tripId, revision])
  @@map("planner_activities")
}

// ─── Trip budget and group expenses (Phase 20) ────────────────────────────

/// Mirrors `expenseCategorySchema` in @wayora/contracts.
enum ExpenseCategory {
  FLIGHTS
  HOTELS
  TRAINS
  BUSES
  LOCAL_TRANSPORT
  FOOD
  ACTIVITIES
  SHOPPING
  OTHER

  @@map("expense_category")
}

/// PAID: money actually spent (split, counts in balances). PLANNED: an estimate.
enum ExpenseStatus {
  PAID
  PLANNED

  @@map("expense_status")
}

enum ExpenseSplitMethod {
  EQUAL
  CUSTOM
  PERCENT

  @@map("expense_split_method")
}

/// A plan's budget (one per plan), in one currency (docs/planner.md#budget).
model PlanBudget {
  tripId           String   @id @map("trip_id") @db.Uuid
  currency         String   @db.Char(3)
  totalAmountMinor BigInt   @map("total_amount_minor")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip       PlannedTrip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  categories PlanCategoryBudget[]

  @@map("plan_budgets")
}

/// Optional per-category budget, in the budget's currency.
model PlanCategoryBudget {
  tripId      String          @map("trip_id") @db.Uuid
  category    ExpenseCategory
  amountMinor BigInt          @map("amount_minor")

  budget PlanBudget @relation(fields: [tripId], references: [tripId], onDelete: Cascade)

  @@id([tripId, category])
  @@map("plan_category_budgets")
}

/// One expense on a plan. Amount in integer minor units of `currency`.
/// A PAID expense's parts add up exactly (deferred constraint trigger).
model PlanExpense {
  id          String              @id @default(uuid(7)) @db.Uuid
  tripId      String              @map("trip_id") @db.Uuid
  description String              @db.VarChar(120)
  category    ExpenseCategory
  amountMinor BigInt              @map("amount_minor")
  currency    String              @db.Char(3)
  /// Calendar date it was spent (or is planned for).
  spentOn     DateTime            @map("spent_on") @db.Date
  status      ExpenseStatus
  splitMethod ExpenseSplitMethod? @map("split_method")
  notes       String?             @db.VarChar(500)
  /// The owner's booking it came from (at most once per plan).
  bookingId   String?             @map("booking_id") @db.Uuid
  createdById String?             @map("created_by_id") @db.Uuid
  /// Bumped on every edit; an edit based on an older version is refused.
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      PlannedTrip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking   Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  parts     PlanExpensePart[]

  @@index([tripId, spentOn, id])
  @@map("plan_expenses")
}

/// One person's part of a paid expense: what they paid and their share.
model PlanExpensePart {
  expenseId   String  @map("expense_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  paidMinor   BigInt  @map("paid_minor")
  shareMinor  BigInt  @map("share_minor")
  /// Percentage splits: this person's percentage in basis points.
  basisPoints Int?    @map("basis_points")

  expense PlanExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([expenseId, userId])
  @@index([userId])
  @@map("plan_expense_parts")
}

/// A payment between two people, made outside Wayora and recorded here.
model PlanSettlement {
  id           String   @id @default(uuid(7)) @db.Uuid
  tripId       String   @map("trip_id") @db.Uuid
  fromUserId   String   @map("from_user_id") @db.Uuid
  toUserId     String   @map("to_user_id") @db.Uuid
  amountMinor  BigInt   @map("amount_minor")
  currency     String   @db.Char(3)
  settledOn    DateTime @map("settled_on") @db.Date
  note         String?  @db.VarChar(500)
  recordedById String?  @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  trip       PlannedTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  from       User        @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to         User        @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)
  recordedBy User?       @relation("SettlementRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@map("plan_settlements")
}

// ─── Travel assistant (Phase 21, docs/assistant.md) ─────────────────────

enum AssistantMessageRole {
  USER
  ASSISTANT

  @@map("assistant_message_role")
}

enum AssistantRequestOutcome {
  OK
  INVALID_OUTPUT
  TIMEOUT
  PROVIDER_ERROR

  @@map("assistant_request_outcome")
}

/// One user's conversation with the assistant, optionally about one plan.
/// Private to that user, even on a shared plan; reading it needs current
/// access to the plan (checked on every request).
model AssistantConversation {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tripId       String?   @map("trip_id") @db.Uuid
  title        String    @db.VarChar(120)
  /// Set while a reply is being prepared, so one conversation runs one request at a time.
  pendingUntil DateTime? @map("pending_until") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip     PlannedTrip?       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]
  requests AssistantRequest[]

  @@index([userId, updatedAt, id])
  @@index([tripId])
  @@map("assistant_conversations")
}

/// What the user saw: their own words, or the validated reply blocks.
/// No prompts, provider output or reasoning are stored.
model AssistantMessage {
  id             String               @id @default(uuid(7)) @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  role           AssistantMessageRole
  text           String?              @db.VarChar(2000)
  blocks         Json?
  intent         String?              @db.VarChar(20)
  provider       String?              @db.VarChar(40)
  providerLabel  String?              @map("provider_label") @db.VarChar(80)
  simulated      Boolean?
  model          String?              @db.VarChar(120)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions      AssistantAction[]

  @@index([conversationId, createdAt, id])
  @@map("assistant_messages")
}

/// One provider call: outcome, latency and token counts only (quota and health).
model AssistantRequest {
  id             String                  @id @default(uuid(7)) @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  conversationId String?                 @map("conversation_id") @db.Uuid
  provider       String                  @db.VarChar(40)
  model          String?                 @db.VarChar(120)
  intent         String                  @db.VarChar(20)
  outcome        AssistantRequestOutcome
  latencyMs      Int                     @map("latency_ms")
  inputTokens    Int?                    @map("input_tokens")
  outputTokens   Int?                    @map("output_tokens")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt, outcome])
  @@map("assistant_requests")
}

/// A proposal the user applied (after confirming), and to which plan.
model AssistantAction {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tripId    String?  @map("trip_id") @db.Uuid
  action    String   @db.VarChar(30)
  blockId   String   @map("block_id") @db.VarChar(4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip    PlannedTrip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@map("assistant_actions")
}

// ─── Supplier reservations, travel documents, refunds (Phase 23) ──────────

/// A supplier reservation's lifecycle (docs/bookings.md#supplier-reservations).
enum ReservationStatus {
  /// Recorded by Wayora; nothing sent to the supplier yet.
  PENDING
  /// Sent, or the supplier accepted it without confirming yet.
  IN_PROGRESS
  /// The supplier confirmed it and gave its reference.
  CONFIRMED
  /// The supplier definitely did not reserve it.
  FAILED
  /// Sent, but no definitive answer: the supplier may or may not have it.
  UNKNOWN
  /// Cancellation asked of the supplier; not confirmed yet.
  CANCELLATION_PENDING
  /// The supplier confirmed the cancellation.
  CANCELLED

  @@map("reservation_status")
}

/// Normalized reasons; never supplier text.
enum ReservationErrorCategory {
  TIMEOUT
  UNAVAILABLE
  INVALID_RESPONSE
  OFFER_UNAVAILABLE
  PRICE_CHANGED
  INVALID_DETAILS
  REJECTED
  NOT_FOUND
  NOT_CANCELLABLE
  PRICE_MISMATCH
  UNKNOWN

  @@map("reservation_error_category")
}

enum TravelDocumentType {
  TICKET
  VOUCHER
  ITINERARY

  @@map("travel_document_type")
}

/// A refund's lifecycle (docs/payments.md#refunds).
enum RefundStatus {
  /// Owed, but the payment's provider can't refund (demo: no money was taken).
  REQUIRED
  /// To be sent to the provider (or being sent).
  REQUESTED
  /// The provider accepted it and is processing it.
  PENDING
  /// The provider confirmed it.
  SUCCEEDED
  /// The provider refused it.
  FAILED
  /// Sent, but no definitive answer yet.
  UNKNOWN

  @@map("refund_status")
}

enum RefundReason {
  BOOKING_CANCELLED
  PAID_AFTER_CLOSE
  /// Requested directly through the payments service (operators, tests).
  MANUAL

  @@map("refund_reason")
}

/// The supplier side of a non-demo booking. One per booking; status changes
/// are conditional updates, and every change is in reservation_events.
model SupplierReservation {
  id                      String                    @id @default(uuid(7)) @db.Uuid
  bookingId               String                    @unique @map("booking_id") @db.Uuid
  provider                String                    @db.VarChar(64)
  status                  ReservationStatus         @default(PENDING)
  /// Wayora's key for this reservation; sent to suppliers that de-duplicate by it.
  idempotencyKey          String                    @unique @map("idempotency_key") @db.Uuid
  /// The supplier's confirmation reference. Set once, from the supplier only.
  supplierReference       String?                   @map("supplier_reference") @db.VarChar(128)
  /// Reservation requests sent.
  attempts                Int                       @default(0) @db.SmallInt
  /// Status lookups made.
  checks                  Int                       @default(0) @db.SmallInt
  /// Cancellation requests sent.
  cancelAttempts          Int                       @default(0) @map("cancel_attempts") @db.SmallInt
  lastAttemptAt           DateTime?                 @map("last_attempt_at") @db.Timestamptz(3)
  /// When recovery next looks at it (also a lease while one process does).
  nextCheckAt             DateTime?                 @map("next_check_at") @db.Timestamptz(3)
  errorCategory           ReservationErrorCategory? @map("error_category")
  /// The last request got no definitive answer.
  ambiguous               Boolean                   @default(false)
  /// Automatic recovery stopped: staff must reconcile with the supplier.
  needsAttention          Boolean                   @default(false) @map("needs_attention")
  /// Correlation id of the request that last changed it.
  requestId               String?                   @map("request_id") @db.VarChar(128)
  /// What the supplier confirmed (validated, normalized). Set once.
  confirmedDetails        Json?                     @map("confirmed_details")
  confirmedAt             DateTime?                 @map("confirmed_at") @db.Timestamptz(3)
  cancellationKey         String?                   @unique @map("cancellation_key") @db.Uuid
  cancellationReference   String?                   @map("cancellation_reference") @db.VarChar(128)
  cancellationRequestedAt DateTime?                 @map("cancellation_requested_at") @db.Timestamptz(3)
  cancelledAt             DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking   Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  events    ReservationEvent[]
  documents TravelDocument[]

  @@unique([provider, supplierReference])
  @@index([status, nextCheckAt])
  @@index([needsAttention])
  @@map("supplier_reservations")
}

/// Append-only history of a reservation's status (a trigger forbids changes).
model ReservationEvent {
  id            String                    @id @default(uuid(7)) @db.Uuid
  reservationId String                    @map("reservation_id") @db.Uuid
  fromStatus    ReservationStatus?        @map("from_status")
  toStatus      ReservationStatus         @map("to_status")
  actorType     AuditActorType            @map("actor_type")
  errorCategory ReservationErrorCategory? @map("error_category")
  note          String?                   @db.VarChar(255)
  requestId     String?                   @map("request_id") @db.VarChar(128)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation SupplierReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId, createdAt])
  @@map("reservation_events")
}

/// A ticket, voucher or itinerary reference the supplier actually issued
/// (never generated by Wayora). Immutable.
model TravelDocument {
  id                String             @id @default(uuid(7)) @db.Uuid
  reservationId     String             @map("reservation_id") @db.Uuid
  bookingId         String             @map("booking_id") @db.Uuid
  type              TravelDocumentType
  reference         String             @db.VarChar(128)
  /// Which booked traveller it is for (position), if per traveller.
  travellerPosition Int?               @map("traveller_position") @db.SmallInt
  issuedAt          DateTime           @map("issued_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation SupplierReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([reservationId, type, reference])
  @@index([bookingId])
  @@map("travel_documents")
}

/// A refund of one payment, tracked apart from the payment and the booking.
/// Amount and currency are the payment's (a trigger checks it).
model Refund {
  id             String       @id @default(uuid(7)) @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  bookingId      String       @map("booking_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       String       @db.VarChar(64)
  mode           PaymentMode
  status         RefundStatus
  reason         RefundReason
  amountMinor    BigInt       @map("amount_minor")
  currency       String       @db.Char(3)
  failureCode    String?      @map("failure_code") @db.VarChar(64)
  attempts       Int          @default(0) @db.SmallInt
  nextAttemptAt  DateTime?    @map("next_attempt_at") @db.Timestamptz(3)
  needsAttention Boolean      @default(false) @map("needs_attention")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([paymentId])
  @@index([status, nextAttemptAt])
  @@map("refunds")
}

// ─── Loyalty, rewards and travel credits (Phase 25, docs/rewards.md) ──────

/// Every change to a points balance or a travel credit (docs/rewards.md#ledger).
enum RewardTransactionType {
  POINTS_EARNED
  POINTS_REDEEMED
  /// Points spent on a booking given back (removed before paying, or the booking closed).
  POINTS_RESTORED
  /// Points earned on a booking taken back (it no longer qualifies).
  POINTS_REVERSED
  POINTS_EXPIRED
  /// A manual adjustment by an admin (positive or negative), with a reason.
  POINTS_ADJUSTED
  CREDIT_ISSUED
  CREDIT_REDEEMED
  /// Credit spent on a booking given back.
  CREDIT_RESTORED
  CREDIT_EXPIRED
  /// Withdrawn by an admin, with a reason.
  CREDIT_REVOKED

  @@map("reward_transaction_type")
}

/// Automated (rules, bookings, expiry) or manual (an admin, with a reason).
enum RewardOrigin {
  AUTOMATED
  MANUAL

  @@map("reward_origin")
}

enum TravelCreditStatus {
  ACTIVE
  /// Fully spent (it can become ACTIVE again if a spend is given back).
  USED
  EXPIRED
  REVOKED

  @@map("travel_credit_status")
}

/// Why a credit exists. There is no "refund" reason: refunds are money and
/// never become credit (docs/rewards.md#travel-credits).
enum TravelCreditReason {
  PROMOTION
  SUPPORT_COMPENSATION
  BOOKING_ADJUSTMENT

  @@map("travel_credit_reason")
}

enum RewardRedemptionStatus {
  /// Points and credit set aside for an unpaid booking; the payment is the rest.
  APPLIED
  /// The booking was paid and confirmed with it.
  CONSUMED
  /// Given back before payment (removed, or the booking expired or failed unpaid).
  RELEASED
  /// Given back after the paid booking was cancelled.
  RESTORED

  @@map("reward_redemption_status")
}

/// One points balance per user and mode. DEMO points come only from demo
/// bookings and can be spent only on demo bookings; LIVE is reserved for real
/// payments (docs/rewards.md#demo-and-live). The balance is a cache of the
/// ledger, changed only together with a ledger row, under this row's lock.
model LoyaltyAccount {
  id              String      @id @default(uuid(7)) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  mode            PaymentMode
  /// Spendable points (sum of this account's ledger points). Never negative.
  pointsBalance   BigInt      @default(0) @map("points_balance")
  /// Tier id from the rules (docs/rewards.md#tiers).
  tier            String      @default("explorer") @db.VarChar(32)
  /// When the current tier was last reached or re-qualified (it is kept for a qualification period from then).
  tierQualifiedAt DateTime?   @map("tier_qualified_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions RewardTransaction[]
  lots         LoyaltyPointLot[]

  @@unique([userId, mode])
  @@map("loyalty_accounts")
}

/// Versioned rules (earning, redemption, tiers, expiry). The version used is
/// stored with each transaction and redemption, so old results stay explainable.
model LoyaltyRuleVersion {
  version       Int      @id
  /// Validated with loyaltyRulesSchema (@wayora/contracts).
  config        Json
  reason        String   @db.VarChar(500)
  /// The admin who created it; null for the version shipped with the migration.
  createdById   String?  @map("created_by_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transactions RewardTransaction[]
  redemptions  RewardRedemption[]

  @@index([effectiveFrom])
  @@map("loyalty_rule_versions")
}

/// The ledger: append-only (a trigger forbids UPDATE and DELETE).
model RewardTransaction {
  id               String                @id @default(uuid(7)) @db.Uuid
  /// Null for credit-only rows of a user without a points account.
  accountId        String?               @map("account_id") @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  mode             PaymentMode
  type             RewardTransactionType
  origin           RewardOrigin
  /// Signed points change (0 for credit rows).
  points           BigInt                @default(0)
  /// Points counted towards tiers (earned base points; negative when reversed).
  qualifyingPoints BigInt                @default(0) @map("qualifying_points")
  /// Points balance after this row (points rows only).
  balanceAfter     BigInt?               @map("balance_after")
  /// Signed credit change in minor units (0 for points rows).
  amountMinor      BigInt                @default(0) @map("amount_minor")
  currency         String?               @db.Char(3)
  creditId         String?               @map("credit_id") @db.Uuid
  bookingId        String?               @map("booking_id") @db.Uuid
  redemptionId     String?               @map("redemption_id") @db.Uuid
  ruleVersion      Int?                  @map("rule_version")
  /// Shown to the user.
  description      String                @db.VarChar(255)
  /// Required for manual rows: why the admin made it.
  reason           String?               @db.VarChar(500)
  actorType        AuditActorType        @map("actor_type")
  actorId          String?               @map("actor_id") @db.Uuid
  /// Makes each automated step happen at most once (e.g. earn:<bookingId>).
  idempotencyKey   String                @unique @map("idempotency_key") @db.VarChar(160)
  /// The calculation (amounts, multipliers) for earned points; never personal data.
  metadata         Json?
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  account     LoyaltyAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  credit      TravelCredit?       @relation(fields: [creditId], references: [id], onDelete: Restrict)
  booking     Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  redemption  RewardRedemption?   @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  rule        LoyaltyRuleVersion? @relation(fields: [ruleVersion], references: [version], onDelete: Restrict)
  lot         LoyaltyPointLot?

  @@index([userId, mode, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([creditId])
  @@index([type, createdAt])
  @@index([origin, createdAt])
  @@index([createdAt(sort: Desc)])
  @@map("reward_transactions")
}

/// Points added by one ledger row (earned or a positive adjustment), with
/// what is left and when it expires. Spending takes from the soonest-expiring
/// lots first (docs/rewards.md#expiry).
model LoyaltyPointLot {
  id            String   @id @default(uuid(7)) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  transactionId String   @unique @map("transaction_id") @db.Uuid
  points        BigInt
  remaining     BigInt
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  /// Set when an "expiring soon" notification was created for it.
  expiryNoticeAt DateTime? @map("expiry_notice_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account     LoyaltyAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction RewardTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([accountId, expiresAt])
  @@map("loyalty_point_lots")
}

/// A travel credit: Wayora-issued value for future bookings, separate from
/// points and never a cash refund (docs/rewards.md#travel-credits).
model TravelCredit {
  id                   String             @id @default(uuid(7)) @db.Uuid
  /// Customer-visible, e.g. WYC-7KQ2-M9XD.
  reference            String             @unique @db.VarChar(32)
  userId               String             @map("user_id") @db.Uuid
  mode                 PaymentMode
  currency             String             @db.Char(3)
  originalAmountMinor  BigInt             @map("original_amount_minor")
  remainingAmountMinor BigInt             @map("remaining_amount_minor")
  reason               TravelCreditReason
  /// Shown to the user (e.g. the campaign or the support case summary).
  note                 String             @db.VarChar(255)
  status               TravelCreditStatus @default(ACTIVE)
  issuedAt             DateTime           @map("issued_at") @db.Timestamptz(3)
  expiresAt            DateTime?          @map("expires_at") @db.Timestamptz(3)
  bookingId            String?            @map("booking_id") @db.Uuid
  campaign             String?            @db.VarChar(80)
  /// The admin who issued it.
  issuedById           String?            @map("issued_by_id") @db.Uuid
  /// Prevents issuing the same credit twice.
  idempotencyKey       String             @unique @map("idempotency_key") @db.VarChar(160)
  expiryNoticeAt       DateTime?          @map("expiry_notice_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  transactions RewardTransaction[]

  @@index([userId, mode, status, expiresAt])
  @@index([status, expiresAt])
  @@map("travel_credits")
}

/// Points and credit set against one booking at checkout (docs/rewards.md#checkout).
/// At most one APPLIED or CONSUMED per booking (partial unique index).
model RewardRedemption {
  id                String                 @id @default(uuid(7)) @db.Uuid
  bookingId         String                 @map("booking_id") @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  mode              PaymentMode
  status            RewardRedemptionStatus @default(APPLIED)
  currency          String                 @db.Char(3)
  points            BigInt
  pointsAmountMinor BigInt                 @map("points_amount_minor")
  creditAmountMinor BigInt                 @map("credit_amount_minor")
  /// pointsAmountMinor + creditAmountMinor (a CHECK enforces it).
  totalAmountMinor  BigInt                 @map("total_amount_minor")
  /// Which lots and credits it took from, to give back exactly: { lots: [{id, points}], credits: [{id, amountMinor}] }.
  allocations       Json
  ruleVersion       Int                    @map("rule_version")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt          DateTime?              @map("closed_at") @db.Timestamptz(3)

  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  rule         LoyaltyRuleVersion  @relation(fields: [ruleVersion], references: [version], onDelete: Restrict)
  transactions RewardTransaction[]

  @@index([bookingId])
  @@index([status, updatedAt])
  @@map("reward_redemptions")
}

// ─── Coupons and promotions (Phase 26, docs/promotions.md) ────────────────

enum PromotionKind {
  /// Applied when the customer enters its code.
  COUPON
  /// Applied by Wayora to eligible bookings without a code.
  AUTOMATIC

  @@map("promotion_kind")
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED

  @@map("promotion_discount_type")
}

/// The life of one use of a promotion on one booking (docs/promotions.md#lifecycle).
enum PromotionRedemptionStatus {
  /// Applied at checkout and holding one use until the booking is paid or the hold ends.
  RESERVED
  /// The booking was paid and confirmed with it.
  REDEEMED
  /// Given up before payment (removed, replaced, no longer valid, abandoned, or the booking closed unpaid).
  RELEASED
  /// The paid booking was cancelled: the use is given back.
  REVERSED

  @@map("promotion_redemption_status")
}

/// A coupon or automatic promotion. Money is integer minor units in `currency`.
model Promotion {
  id               String                @id @default(uuid(7)) @db.Uuid
  kind             PromotionKind
  /// Coupons only: normalized (upper-case, no spaces), unique for ever.
  code             String?               @unique @db.VarChar(24)
  name             String                @db.VarChar(80)
  description      String                @db.VarChar(255)
  terms            String                @db.VarChar(2000)
  discountType     PromotionDiscountType @map("discount_type")
  /// PERCENTAGE: basis points (1000 = 10%).
  percentBps       Int?                  @map("percent_bps")
  /// FIXED: the amount off.
  amountMinor      BigInt?               @map("amount_minor")
  /// PERCENTAGE: the most it takes off.
  maxDiscountMinor BigInt?               @map("max_discount_minor")
  minAmountMinor   BigInt                @default(0) @map("min_amount_minor")
  currency         String                @db.Char(3)
  /// Empty = every category.
  categories       TravelCategory[]      @default([])
  startsAt         DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime              @map("ends_at") @db.Timestamptz(3)
  usageLimit       Int?                  @map("usage_limit")
  perUserLimit     Int?                  @map("per_user_limit")
  firstBookingOnly Boolean               @default(false) @map("first_booking_only")
  /// A personal offer for one customer.
  userId           String?               @map("user_id") @db.Uuid
  /// Coupons: may combine with an automatic promotion.
  stackable        Boolean               @default(false)
  listed           Boolean               @default(true)
  active           Boolean               @default(true)
  /// +1 on every change; redemptions keep the version they used.
  version          Int                   @default(1)
  createdById      String?               @map("created_by_id") @db.Uuid
  updatedById      String?               @map("updated_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User?                 @relation("PromotionForUser", fields: [userId], references: [id], onDelete: Restrict)
  redemptions PromotionRedemption[]

  @@index([kind, active, startsAt, endsAt])
  @@index([userId])
  @@map("promotions")
}

/// One use of a promotion on one booking. Never deleted (usage history).
model PromotionRedemption {
  id                  String                    @id @default(uuid(7)) @db.Uuid
  promotionId         String                    @map("promotion_id") @db.Uuid
  bookingId           String                    @map("booking_id") @db.Uuid
  userId              String                    @map("user_id") @db.Uuid
  kind                PromotionKind
  status              PromotionRedemptionStatus @default(RESERVED)
  /// The code as entered (normalized), for history.
  code                String?                   @db.VarChar(24)
  /// What it was calculated on (the booking total, or the total after an automatic promotion).
  eligibleAmountMinor BigInt                    @map("eligible_amount_minor")
  discountMinor       BigInt                    @map("discount_minor")
  currency            String                    @db.Char(3)
  promotionVersion    Int                       @map("promotion_version")
  /// The hold ends then unless the booking is being paid (its payment window).
  reservedUntil       DateTime                  @map("reserved_until") @db.Timestamptz(3)
  redeemedAt          DateTime?                 @map("redeemed_at") @db.Timestamptz(3)
  closedAt            DateTime?                 @map("closed_at") @db.Timestamptz(3)
  /// Why it was released or reversed (REMOVED, REPLACED, COUPON_EXPIRED, COUPON_INACTIVE, RESERVATION_EXPIRED, BOOKING_CLOSED, BOOKING_CANCELLED).
  closeReason         String?                   @map("close_reason") @db.VarChar(64)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([promotionId, status])
  @@index([promotionId, userId, status])
  @@index([bookingId])
  @@index([status, reservedUntil])
  @@map("promotion_redemptions")
}
