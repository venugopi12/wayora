// Wayora — Phase 1 foundational schema.
//
// Conventions (see docs/architecture.md#database):
// - Primary keys are UUIDv7 (time-ordered, index-friendly), stored as native `uuid`.
// - All timestamps are `timestamptz(3)` and written in UTC.
// - Money is stored as BIGINT minor units (`*AmountMinor`) + ISO 4217 `currency`.
//   Never use Float/Decimal-with-float-math for money.
// - Table/column names are snake_case via @@map/@map; Prisma models are PascalCase.
// - CHECK constraints that Prisma cannot express live in the migration SQL.
// - No raw card data is ever stored. Payment references come from the PSP.

// Prisma 7 TypeScript client (no native query engine). Generated into
// src/generated/prisma (git-ignored) and re-exported by src/index.ts.
generator client {
  provider            = "prisma-client"
  output              = "./src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Connection URL is configured in prisma.config.ts (CLI) and passed to the
// pg driver adapter at runtime (src/index.ts).
datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

/// Mirrors `travelCategorySlugSchema` in @wayora/contracts.
enum TravelCategory {
  FLIGHT
  HOTEL
  TRAIN
  BUS
  METRO
  CAB
  HOLIDAY_PACKAGE

  @@map("travel_category")
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
  FAILED

  @@map("order_status")
}

enum BookingStatus {
  PENDING
  HELD
  CONFIRMED
  CANCELLED
  FAILED
  /// Not paid within the payment window (Phase 13).
  EXPIRED

  @@map("booking_status")
}

/// How a booking is paid (Phase 13, docs/payments.md#booking-payment-mode).
enum BookingPaymentMode {
  /// Nothing is paid on Wayora (Phase 12 bookings, payments off, estimate prices).
  NONE
  /// A simulated payment is required before the demo confirmation.
  DEMO

  @@map("booking_payment_mode")
}

/// Payment attempt lifecycle (docs/payments.md#states).
enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

/// DEMO: simulated, no money moves. LIVE: reserved for a real gateway.
enum PaymentMode {
  DEMO
  LIVE

  @@map("payment_mode")
}

/// Passenger types where a fare distinguishes them (flights).
enum PassengerType {
  ADULT
  CHILD
  INFANT

  @@map("passenger_type")
}

enum BookingItemStatus {
  ACTIVE
  CANCELLED

  @@map("booking_item_status")
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("idempotency_key_status")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED

  @@map("webhook_event_status")
}

enum AuditActorType {
  USER
  SYSTEM
  ADMIN
  PROVIDER

  @@map("audit_actor_type")
}

// ─── Identity ─────────────────────────────────────────────────────────────

/// An account holder. Signs in with email + password (Phase 8).
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Normalized (trimmed, lower-cased) by the application and enforced by a
  /// CHECK constraint, so the unique index is effectively case-insensitive.
  email           String     @unique @db.VarChar(320)
  /// Set only by a real verification flow (not implemented yet).
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// The person's name, as shown in the app ("name" in the API).
  displayName     String?    @map("display_name") @db.VarChar(120)
  /// Argon2id PHC string. Null for accounts without a password (e.g. seed data),
  /// which therefore cannot sign in. Never returned by the API.
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  /// E.164 format, e.g. +919876543210.
  phoneE164       String?    @map("phone_e164") @db.VarChar(16)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  travellers Traveller[]
  orders     Order[]
  sessions   Session[]
  bookings   Booking[]
  payments   Payment[]

  @@index([status])
  @@map("users")
}

/// A signed-in browser session. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a database leak does not expose usable sessions.
/// A session authenticates only while revokedAt is null, expiresAt is in the
/// future and the user is ACTIVE (docs/auth.md#session-lifecycle).
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Hex SHA-256 of the cookie token.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Refreshed at most every few minutes while the session is used.
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// min(createdAt + absolute lifetime, lastActivityAt + idle timeout).
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A person who travels on a booking (may differ from the account holder).
/// Identity documents (passport etc.) are deliberately NOT modelled yet; they
/// require field-level encryption and a retention policy first.
model Traveller {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  firstName   String    @map("first_name") @db.VarChar(100)
  lastName    String    @map("last_name") @db.VarChar(100)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  /// ISO 3166-1 alpha-2.
  nationality String?   @db.Char(2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([userId])
  @@map("travellers")
}

// ─── Commerce ─────────────────────────────────────────────────────────────

/// The customer-facing purchase. One order can contain bookings across
/// categories (e.g. a flight + a hotel) and is the unit of payment.
model Order {
  id               String      @id @default(uuid(7)) @db.Uuid
  /// Human-friendly, customer-visible reference, e.g. WY-7KQ2-M9XD.
  reference        String      @unique @db.VarChar(32)
  userId           String      @map("user_id") @db.Uuid
  status           OrderStatus @default(DRAFT)
  currency         String      @db.Char(3)
  totalAmountMinor BigInt      @default(0) @map("total_amount_minor")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

/// A reservation of one offer (Phase 12: demo bookings; docs/bookings.md).
///
/// Demo bookings (`isDemo`) are created and confirmed by Wayora alone: no
/// supplier reservation, ticket or payment exists, so `providerReference` stays
/// null. The offer is kept as an immutable snapshot; a trigger rejects changes
/// to it and to the other booked facts. Payments later attach bookings to an
/// `Order` (the unit of payment), hence the optional `orderId`.
model Booking {
  id                String             @id @default(uuid(7)) @db.Uuid
  /// Customer-visible reference, e.g. WYD-7KQ2-M9XD ("WYD": Wayora demo booking).
  reference         String             @unique @db.VarChar(32)
  userId            String             @map("user_id") @db.Uuid
  orderId           String?            @map("order_id") @db.Uuid
  category          TravelCategory
  status            BookingStatus      @default(PENDING)
  /// Simulated booking: no supplier reservation, ticket or payment.
  isDemo            Boolean            @map("is_demo")
  /// Provider identifier, e.g. "demo-flights".
  provider          String?            @db.VarChar(64)
  /// Provider-side reference (PNR, confirmation number). Never set for demo bookings.
  providerReference String?            @map("provider_reference") @db.VarChar(128)
  /// The search session the offer came from (sessions expire; kept for support).
  searchId          String?            @map("search_id") @db.Uuid
  /// The offer as booked: validated contract JSON (see docs/bookings.md#snapshot).
  offerSnapshot     Json               @map("offer_snapshot")
  /// People the booked price covers.
  partySize         Int                @map("party_size")
  /// Local travel dates from the offer; null where it has none (metro).
  startsOn          DateTime?          @map("starts_on") @db.Date
  endsOn            DateTime?          @map("ends_on") @db.Date
  /// E.164 mobile number, only for categories that need one (cabs).
  contactPhone      String?            @map("contact_phone") @db.VarChar(16)
  currency          String             @db.Char(3)
  /// The booked total. Null when the offer's price is an estimate range (cabs);
  /// the range is in the snapshot.
  totalAmountMinor  BigInt?            @map("total_amount_minor")
  /// How it is paid; fixed when booked (Phase 13).
  paymentMode       BookingPaymentMode @map("payment_mode")
  /// Pay before this or the booking expires (payment mode DEMO only).
  paymentDueAt      DateTime?          @map("payment_due_at") @db.Timestamptz(3)
  confirmedAt       DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  order      Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items      BookingItem[]
  travellers BookingTraveller[]
  events     BookingStatusEvent[]
  payments   Payment[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([category, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, startsOn])
  @@index([status, paymentDueAt])
  @@map("bookings")
}

/// A named person on a booking, copied from the booking form (immutable).
/// Not linked to saved travellers: editing a saved traveller never changes a booking.
model BookingTraveller {
  id        String         @id @default(uuid(7)) @db.Uuid
  bookingId String         @map("booking_id") @db.Uuid
  /// Order on the booking (0-based), as the form listed them.
  position  Int            @db.SmallInt
  /// Only for fares that distinguish passenger types (flights).
  type      PassengerType?
  firstName String         @map("first_name") @db.VarChar(100)
  lastName  String         @map("last_name") @db.VarChar(100)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
  @@map("booking_travellers")
}

/// Append-only status history of a booking (a trigger blocks UPDATE and DELETE).
model BookingStatusEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  /// Null for the event that created the booking.
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorType  AuditActorType @map("actor_type")
  /// Plain-words explanation, e.g. that a demo confirmation contacted no supplier.
  note       String?        @db.VarChar(255)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_events")
}

/// A priced line within a booking (a seat, a room-night, a fare component).
// ─── Payments (Phase 13) ──────────────────────────────────────────────────

/// One attempt to pay for one booking (docs/payments.md). Separate from the
/// booking's lifecycle: a succeeded payment never means a supplier reserved
/// anything. Rows are kept for audit; card or bank details are never stored
/// (the demo provider takes none; a real gateway keeps them on its side).
model Payment {
  id                 String        @id @default(uuid(7)) @db.Uuid
  bookingId          String        @map("booking_id") @db.Uuid
  /// The owner (the booking's user), kept for direct ownership checks.
  userId             String        @map("user_id") @db.Uuid
  /// 1, 2, … per booking.
  attempt            Int           @db.SmallInt
  mode               PaymentMode
  /// Provider id, e.g. "demo".
  provider           String        @db.VarChar(64)
  /// The provider's id for this attempt (never a secret). Set once.
  providerReference  String?       @map("provider_reference") @db.VarChar(128)
  status             PaymentStatus @default(CREATED)
  currency           String        @db.Char(3)
  /// From the booking's record, never from the client.
  amountMinor        BigInt        @map("amount_minor")
  /// The simulated outcome asked for (DEMO mode only).
  demoScenario       String?       @map("demo_scenario") @db.VarChar(32)
  /// SHA-256 of the client's Idempotency-Key (the key itself isn't kept here).
  idempotencyKeyHash String?       @map("idempotency_key_hash") @db.Char(64)
  /// Safe, user-facing failure reason.
  failureCode        String?       @map("failure_code") @db.VarChar(64)
  failureMessage     String?       @map("failure_message") @db.VarChar(255)
  /// Succeeded after its booking was cancelled or expired: money would be owed back.
  refundRequired     Boolean       @default(false) @map("refund_required")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When it first reached succeeded, failed or cancelled.
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(3)

  booking Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  events  PaymentStatusEvent[]

  @@unique([bookingId, attempt])
  @@unique([provider, providerReference])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payments")
}

/// Append-only history of a payment's status (a trigger forbids changes).
model PaymentStatusEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  paymentId       String         @map("payment_id") @db.Uuid
  /// Null for the event that created the payment.
  fromStatus      PaymentStatus? @map("from_status")
  toStatus        PaymentStatus  @map("to_status")
  actorType       AuditActorType @map("actor_type")
  /// The provider event that caused it (see webhook_events), if any.
  providerEventId String?        @map("provider_event_id") @db.VarChar(255)
  note            String?        @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@map("payment_status_events")
}

model BookingItem {
  id               String            @id @default(uuid(7)) @db.Uuid
  bookingId        String            @map("booking_id") @db.Uuid
  travellerId      String?           @map("traveller_id") @db.Uuid
  status           BookingItemStatus @default(ACTIVE)
  description      String            @db.VarChar(255)
  quantity         Int               @default(1)
  currency         String            @db.Char(3)
  unitAmountMinor  BigInt            @map("unit_amount_minor")
  totalAmountMinor BigInt            @map("total_amount_minor")
  /// Category-specific, non-sensitive attributes (e.g. cabin class, room type).
  attributes       Json?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  traveller Traveller? @relation(fields: [travellerId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([travellerId])
  @@map("booking_items")
}

// ─── Reliability & compliance ─────────────────────────────────────────────

/// Stores the outcome of mutating requests so client retries are safe.
/// Rows are short-lived; a scheduled worker job purges expired keys.
model IdempotencyKey {
  id             String               @id @default(uuid(7)) @db.Uuid
  /// Client-supplied `Idempotency-Key` header value.
  key            String               @db.VarChar(255)
  /// Operation the key applies to, e.g. "POST /api/v1/orders".
  scope          String               @db.VarChar(128)
  /// Owner of the key; keys are never shared across users.
  userId         String?              @map("user_id") @db.Uuid
  /// SHA-256 of the canonical request body; mismatches are rejected.
  requestHash    String               @map("request_hash") @db.Char(64)
  status         IdempotencyKeyStatus @default(IN_PROGRESS)
  responseStatus Int?                 @map("response_status") @db.SmallInt
  responseBody   Json?                @map("response_body")
  lockedUntil    DateTime?            @map("locked_until") @db.Timestamptz(3)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Inbound provider/PSP webhooks, recorded before processing so delivery is
/// at-least-once and processing is idempotent (unique provider + external id).
model WebhookEvent {
  id                String             @id @default(uuid(7)) @db.Uuid
  provider          String             @db.VarChar(64)
  /// The provider's event ID — used for de-duplication.
  externalId        String             @map("external_id") @db.VarChar(255)
  eventType         String             @map("event_type") @db.VarChar(128)
  /// Verified payload. Must never contain raw card data (PSPs do not send it).
  payload           Json
  signatureVerified Boolean            @default(false) @map("signature_verified")
  status            WebhookEventStatus @default(RECEIVED)
  attempts          Int                @default(0)
  lastError         String?            @map("last_error")
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

/// Append-only record of security- and money-relevant actions.
model AuditLog {
  id         String         @id @default(uuid(7)) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.VarChar(64)
  /// Dot-namespaced verb, e.g. "order.status_changed".
  action     String         @db.VarChar(128)
  entityType String         @map("entity_type") @db.VarChar(64)
  entityId   String         @map("entity_id") @db.VarChar(64)
  requestId  String?        @map("request_id") @db.VarChar(128)
  /// Non-sensitive context (before/after status, reason codes). No secrets/PII.
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
